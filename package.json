{
  "name": "bang-launchpad",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5211",
    "build": "vite build",
    "start": "npm run build && node server/app.mjs",
    "serve": "node --env-file-if-exists=.env.local server/app.mjs",
    "test": "node --test tests/*.test.mjs",
    "compile:contract": "node scripts/compile-contract.mjs",
    "test:contract": "npm run compile:contract && node --test tests/contracts/*.test.mjs",
    "admin:password": "node scripts/admin-password.mjs",
    "test:fork": "node scripts/fork-check-runner.mjs"
  },
  "dependencies": {
    "@binance/agentic-wallet": "1.11.0",
    "pngjs": "7.0.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "three": "0.180.0",
    "viem": "2.57.7"
  },
  "devDependencies": {
    "@foundry-rs/anvil": "1.7.1",
    "@openzeppelin/contracts": "4.9.6",
    "@openzeppelin/contracts-upgradeable": "4.9.6",
    "ethers": "6.17.0",
    "ganache": "7.9.2",
    "solc": "0.8.30",
    "vite": "7.3.7"
  }
}
